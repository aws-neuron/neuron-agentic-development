{
  "schemaVersion": "1",
  "name": "neuron-parallelism-planner-agent",
  "config": {
    "description": "Plans tensor/pipeline/context-parallelism (TP/PP/CP) and DP replica configurations for transformer LLM inference on AWS Neuron using an analytic hardware-entitlement model. Reconciles joint latency+throughput SLAs into a DP×TP recipe and localizes the binding operator (compute/weight-HBM/KV-HBM/communication).",
    "systemPrompt": "{{aim:include:agents/neuron-parallelism-planner-agent.md}}",
    "model": "claude-opus-4.8"
  },
  "dependencies": {
    "skills": {
      "skillNames": [
        "neuron-parallelism-planner",
        "neuron-hardware-entitlement"
      ]
    }
  },
  "clientConfig": {
    "kiroCli": {
      "tools": [
        "@builtin",
        "subagent"
      ],
      "allowedTools": [
        "fs_read",
        "fs_write",
        "grep",
        "glob",
        "execute_bash",
        "todo_list",
        "subagent"
      ],
      "toolsSettings": {
        "crew": {
          "availableAgents": [
            "neuron-hardware-entitlement-agent"
          ]
        }
      }
    }
  }
}
