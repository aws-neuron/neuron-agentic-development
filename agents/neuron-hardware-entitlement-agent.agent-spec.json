{
  "schemaVersion": "1",
  "name": "neuron-hardware-entitlement-agent",
  "config": {
    "description": "Computes the per-operator hardware-entitlement floor for a chosen transformer-LLM inference parallelism config on AWS Neuron, and localizes which operator binds (compute vs weight-HBM vs KV-HBM vs communication) to route optimization effort correctly.",
    "systemPrompt": "{{aim:include:agents/neuron-hardware-entitlement-agent.md}}",
    "model": "claude-opus-4.8"
  },
  "dependencies": {
    "skills": {
      "skillNames": [
        "neuron-hardware-entitlement",
        "neuron-parallelism-planner"
      ]
    }
  },
  "clientConfig": {
    "kiroCli": {
      "tools": [
        "@builtin",
        "subagent"
      ],
      "allowedTools": [
        "fs_read",
        "fs_write",
        "grep",
        "glob",
        "execute_bash",
        "todo_list",
        "subagent"
      ],
      "toolsSettings": {
        "crew": {
          "availableAgents": [
            "neuron-parallelism-planner-agent"
          ]
        }
      }
    }
  }
}
