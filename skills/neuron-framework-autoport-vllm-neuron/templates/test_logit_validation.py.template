pytestmark = [pytest.mark.full_model_test, pytest.mark.{{PYTEST_MARKER}}]


# ============================================================================
# Online Serving Tests (On-Device Sampling)
# ============================================================================

@pytest.mark.online_serving
@pytest.mark.on_device_sampling
@pytest.mark.multi_prompt
@pytest.mark.timeout(7200)
def test_online_multi_prompt_logit_validation(model_id, max_num_seqs, tp_size, seq_len, request):
    """Validate logits are consistent across multiple prompts in online mode."""
    {{SKIP_CONDITIONS}}
    _setup_cc_buffer(seq_len)

    # Tolerance map: {top_k: (atol, rtol)}
    # Adjust based on observed numerical variance for this model/quantization.
    custom_tol_map = {
        "5": (1e-5, {{TOL_K5}}),
        "50": (1e-5, {{TOL_K50}}),
        "1000": (1e-5, {{TOL_K1000}}),
        "all": (1e-5, {{TOL_ALL}}),
    }

    results = run_logit_test_flow(
        model_id=model_id,
        prompts=PROMPTS_2,
        test_multi_prompt=True,
        test_name=request.node.name,
        vllm_args=_make_args(max_num_seqs, tp_size, seq_len, ods=True),
        output_length=16,
        output_path=OUTPUT_PATH,
        server_timeout=1800,
        tol_map=custom_tol_map,
    )
    assert results["multi_prompt"], "Online multi-prompt logit validation failed"


