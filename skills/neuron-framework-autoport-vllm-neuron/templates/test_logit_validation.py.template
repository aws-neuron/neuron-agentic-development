# Model IDs
MODEL_ID = "{{HF_MODEL_ID}}"
OUTPUT_PATH = os.environ.get("WORKLOAD_OUTPUT_RW", "./")

# CC buffer sizing for large sequence lengths
_HIDDEN_SIZE = {{HIDDEN_SIZE}}
_CC_BUFFER_DEFAULT = {{CC_BUFFER_DEFAULT}}  # bytes


def _setup_cc_buffer(seq_len: int) -> None:
    """Set NEURON_RT_DBG_INTRA_RDH_CHANNEL_BUFFER_SIZE for large seq_lens.

    Required when cc_msg_size = seq_len * hidden_size * 2 exceeds the NRT default.
    """
    cc_msg_size = seq_len * _HIDDEN_SIZE * 2
    current = int(os.environ.get("NEURON_RT_DBG_INTRA_RDH_CHANNEL_BUFFER_SIZE", "0"))
    if cc_msg_size > max(current, _CC_BUFFER_DEFAULT):
        os.environ["NEURON_RT_DBG_INTRA_RDH_CHANNEL_BUFFER_SIZE"] = str(cc_msg_size)


def _make_args(
    max_num_seqs: int = 1,
    tp_size: int = {{DEFAULT_TP}},
    seq_len: int = 256,
    ods: bool = False,
    {{MAKE_ARGS_EXTRA_PARAMS}}
) -> dict:
    """Build vLLM configuration arguments for {{MODEL_TITLE}} canonical logit tests.

    Args:
        max_num_seqs: Maximum number of sequences to process in parallel.
        tp_size: Tensor parallel size.
        seq_len: Maximum sequence length.
        ods: Enable on-device sampling.
        {{MAKE_ARGS_EXTRA_DOCSTRING}}

    Returns:
        Dictionary of vLLM configuration arguments.
    """
    neuron_config = {
        {{NEURON_CONFIG_EXTRA}}
        "on_device_sampling_config": {"all_greedy": True} if ods else None,
        "num_batched_tokens_buckets": [seq_len],
        "num_seqs_buckets": [max_num_seqs],
    }
    {{NEURON_CONFIG_CONDITIONAL}}

    args = {
        "max_model_len": seq_len,
        "max_num_batched_tokens": seq_len,
        "tensor_parallel_size": tp_size,
        "max_logprobs": -1,
        "logprobs_mode": "raw_logits",
        "max_num_seqs": max_num_seqs,
        "dtype": "bfloat16",
        "enable_prefix_caching": False,
        {{VLLM_ARGS_EXTRA}}
        "additional_config": {"neuron_config": neuron_config},
    }
    {{VLLM_ARGS_CONDITIONAL}}

    return args


